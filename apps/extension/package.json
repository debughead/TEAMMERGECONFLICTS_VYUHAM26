{
  "name": "extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@redactguard/core": "workspace:*",
    "@tesseract.js-data/eng": "1.0.0",
    "comlink": "4.4.2",
    "idb": "8.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tesseract.js": "7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "3.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/chrome": "^0.3.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "scripts": {
    "vendor": "node ../weblab/scripts/copy-vendor.mjs .",
    "build": "node ../weblab/scripts/copy-vendor.mjs . && tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:e2e": "node ../weblab/scripts/copy-vendor.mjs . && vite build --mode e2e --outDir dist-e2e"
  }
}
